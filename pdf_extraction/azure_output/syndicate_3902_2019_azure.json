        [
          "Category",
          "Description"
        ],
        [
          "Marine & Energy",
          "Cargo & Specie: Focus on small / medium sized accounts, excludes cash in transit, war on land and jewellers block."
        ],
        [
          "Marine & Energy",
          "Marine Hull & liability: emphasis on smaller brown water tonnage and older vessels on limited conditions and P&I, charters and umbrella liability."
        ],
        [
          "Marine & Energy",
          "Energy: Upstream oil and gas focussed with a broad geographical spread."
        ],
        [
          "Property",
          "Direct & Facultative: predominately written on an excess of loss basis, and consists of a diverse mix of municipalities, real estate, heavy industry, energy, utility, transport and leisure."
        ],
        [
          "Specialty",
          "Aviation: consists of airline, general aviation (including rotor wing), hull war and excess of loss / space."
        ],
        [
          "Specialty",
          "Accident & Health: Excess of loss reinsurance makes up approximately 60% of the account, with the remainder comprising a portfolio of contracts which cover key man, disability, credit card, sports and other personal accident risks, along with a small direct and facultative account."
        ],
        [
          "Specialty",
          "Contingency: predominantly short tail with event cancellation the largest part."
        ]
      ],
