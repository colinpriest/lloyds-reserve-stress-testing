      "grid": [
        [
          "Class of business",
          "Description"
        ],
        [
          "Casualty Reinsurance - US",
          "Predominantly Medical Malpractice, Professional Liability and some General Liability."
        ],
        [
          "Property Reinsurance",
          "Predominantly non-proportional, balanced between US and Rest of World (\"ROW\") exposures."
        ]
      ],
      "orig_page": 7,
      "categories": [
        "claims_triangle",
        "pl_account",
